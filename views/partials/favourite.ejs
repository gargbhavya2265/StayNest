<!-- Favourite Button -->
<form action="/favourites" method="POST" class="flex w-full">
  <input type="hidden" name="id" value="<%= home._id %>" />

  <button
    type="submit"
    class="flex min-h-12 w-full items-center justify-center rounded-lg bg-green-500 px-3 py-3 text-center text-sm font-medium text-white shadow transition duration-300 hover:bg-green-600"
  >
    Add to Favourite
  </button>
</form>
