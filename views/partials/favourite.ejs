<!-- Favourite Button -->
<form action="/favourites" method="POST">
  <input type="hidden" name="id" value="<%= home._id %>" />
  <button
    type="submit"
    class="bg-green-500 hover:bg-green-600 text-white text-sm font-medium px-4 py-2 rounded-lg shadow transition duration-300"
  >
    Add to Favourite
  </button>
</form>