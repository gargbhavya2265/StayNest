
<%- include('../partials/head') %>
</head>
<body class="bg-gray-50">
  <%- include('../partials/nav') %>

  <main class="container mx-auto max-w-3xl px-4 py-10">
    <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
      <div class="border-b border-gray-100 px-6 py-6 md:px-8">
        <a
          href="/homes/<%= home._id %>"
          class="inline-flex items-center gap-2 text-sm font-semibold text-red-500 transition hover:text-red-600"
        >
          <span aria-hidden="true">&larr;</span> Back to home
        </a>

        <h1 class="mt-5 text-2xl font-bold tracking-tight text-gray-800 md:text-3xl">
          Book <%= home.houseName %>
        </h1>

        <p class="mt-2 text-sm text-gray-500">
          <%= home.location %>
        </p>

        <div class="mt-5 flex flex-wrap items-center gap-2">
          <span class="text-2xl font-bold text-gray-900">
            ₹<%= home.price %>
          </span>
          <span class="text-sm text-gray-500">per night</span>
        </div>
      </div>

      <div class="px-6 py-6 md:px-8 md:py-8">
        <% if (error) { %>
          <div
            class="mb-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700"
            role="alert"
          >
            <p class="font-semibold">Booking could not be completed</p>
            <p class="mt-1"><%= error %></p>
          </div>
        <% } %>

        <h2 class="text-lg font-bold text-gray-800">Your trip details</h2>
        <p class="mt-1 text-sm text-gray-500">
          Choose your dates and the number of guests.
        </p>

        <form
          action="/homes/<%= home._id %>/reserve"
          method="POST"
          class="mt-6 space-y-5"
        >
          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div>
              <label for="checkIn" class="mb-2 block text-sm font-semibold text-gray-700">
                Check-in date
              </label>
              <input
                type="date"
                id="checkIn"
                name="checkIn"
                min="<%= today %>"
                value="<%= values.checkIn || '' %>"
                required
                class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-gray-800 outline-none transition focus:border-red-400 focus:ring-2 focus:ring-red-100"
              />
            </div>

            <div>
              <label for="checkOut" class="mb-2 block text-sm font-semibold text-gray-700">
                Check-out date
              </label>
              <input
                type="date"
                id="checkOut"
                name="checkOut"
                min="<%= today %>"
                value="<%= values.checkOut || '' %>"
                required
                class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-gray-800 outline-none transition focus:border-red-400 focus:ring-2 focus:ring-red-100"
              />
            </div>
          </div>

          <div>
            <label for="guests" class="mb-2 block text-sm font-semibold text-gray-700">
              Number of guests
            </label>
            <input
              type="number"
              id="guests"
              name="guests"
              min="1"
              max="20"
              value="<%= values.guests || 1 %>"
              required
              class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-gray-800 outline-none transition focus:border-red-400 focus:ring-2 focus:ring-red-100 sm:max-w-xs"
            />
          </div>

          <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
            <p class="text-sm font-semibold text-gray-800">Before you confirm</p>
            <p class="mt-1 text-sm leading-6 text-gray-600">
              Your total depends on the nightly price and length of stay.
              The selected dates will be checked for availability.
            </p>
          </div>

          <button
            type="submit"
            class="w-full rounded-xl bg-red-500 px-6 py-3.5 font-semibold text-white shadow-sm transition hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-red-400 focus:ring-offset-2 active:scale-[0.99]"
          >
            Confirm Booking
          </button>
        </form>
      </div>
    </div>
  </main>

  <script>
    const checkInInput = document.getElementById("checkIn");
    const checkOutInput = document.getElementById("checkOut");

    checkInInput.addEventListener("change", () => {
      checkOutInput.min = checkInInput.value || "<%= today %>";

      if (
        checkOutInput.value &&
        checkOutInput.value <= checkInInput.value
      ) {
        checkOutInput.value = "";
      }
    });
  </script>
</body>
</html>
