<%- include('../partials/head') %>
</head>
<body class="bg-gray-50">
  <%- include('../partials/nav') %>

  <main class="container mx-auto max-w-3xl px-4 py-10">
    <div class="rounded-2xl bg-white p-6 shadow-lg md:p-8">
      <a href="/homes/<%= home._id %>" class="text-red-500 hover:underline">
        &larr; Back to home
      </a>

      <h1 class="mt-5 text-3xl font-bold text-gray-800">
        Book <%= home.houseName %>
      </h1>

      <p class="mt-2 text-gray-600"><%= home.location %></p>

      <p class="mt-3 text-xl font-bold text-green-600">
        ₹<%= home.price %> per night
      </p>

      <% if (error) { %>
        <div class="mt-5 rounded-lg bg-red-100 p-4 text-red-700" role="alert">
          <%= error %>
        </div>
      <% } %>

      <form
        action="/homes/<%= home._id %>/reserve"
        method="POST"
        class="mt-6 space-y-5"
      >
        <div>
          <label for="checkIn" class="mb-2 block font-semibold text-gray-700">
            Check-in
          </label>
          <input
            type="date"
            id="checkIn"
            name="checkIn"
            min="<%= today %>"
            value="<%= values.checkIn || '' %>"
            required
            class="w-full rounded-lg border border-gray-300 p-3"
          />
        </div>

        <div>
          <label for="checkOut" class="mb-2 block font-semibold text-gray-700">
            Check-out
          </label>
          <input
            type="date"
            id="checkOut"
            name="checkOut"
            min="<%= today %>"
            value="<%= values.checkOut || '' %>"
            required
            class="w-full rounded-lg border border-gray-300 p-3"
          />
        </div>

        <div>
          <label for="guests" class="mb-2 block font-semibold text-gray-700">
            Number of guests
          </label>
          <input
            type="number"
            id="guests"
            name="guests"
            min="1"
            max="20"
            value="<%= values.guests || 1 %>"
            required
            class="w-full rounded-lg border border-gray-300 p-3"
          />
        </div>

        <div class="rounded-lg bg-gray-100 p-4 text-sm text-gray-600">
          Total price is calculated using the home's price per night and the
          number of nights. Your selected dates will be checked for conflicts.
        </div>

        <button
          type="submit"
          class="w-full rounded-lg bg-red-500 px-6 py-3 font-semibold text-white hover:bg-red-600"
        >
          Confirm Booking
        </button>
      </form>
    </div>
  </main>

  <script>
    const checkInInput = document.getElementById("checkIn");
    const checkOutInput = document.getElementById("checkOut");

    checkInInput.addEventListener("change", () => {
      checkOutInput.min = checkInInput.value || "<%= today %>";

      if (
        checkOutInput.value &&
        checkOutInput.value <= checkInInput.value
      ) {
        checkOutInput.value = "";
      }
    });
  </script>
</body>
</html>